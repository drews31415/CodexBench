# Public Dev inputs are content-pinned and must retain their bytes on checkout.
benchmarks/smoke/**/*.py text eol=lf
benchmarks/smoke/**/*.json text eol=lf
benchmarks/pilot/**/*.py text eol=lf
benchmarks/pilot/**/*.json text eol=lf
benchmarks/main_public/** text eol=lf
tests/fixtures/evaluation/**/*.py text eol=lf
tests/fixtures/evaluation/**/*.json text eol=lf
# Hash-pinned records (freeze, approval, amendment, instructions) keep their exact bytes.
configs/** -text
docs/project/AMENDMENT_01_AI_REVIEW_EMERGENCY_MAIN.md -text
docs/project/AMD01_*.md -text
# Public submission bundle: hash-verified bytes (verify-public compares SHA-256), keep exactly as built.
docs/submission/data/** -text
docs/submission/figures/** -text
docs/submission/dashboard.html -text
# Versioned public store for the web dashboard: MANIFEST hashes cover exact bytes.
public_data/** -text
# Static GitHub Pages dashboard: generated, byte-compared with a fresh build.
docs/dashboard/** -text
docs/index.html -text
docs/.nojekyll -text
